# ==============================================================================
# Grounded RAG Environment Configuration (.env.example)
# Note: Never commit actual secret keys to version control.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL & pgvector Configuration (Local Docker Default)
# ------------------------------------------------------------------------------
# Local Docker or Hosted PostgreSQL (Supabase / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grounded_rag
# Direct connection string for migrations if using PgBouncer
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/grounded_rag

# ------------------------------------------------------------------------------
# Redis & BullMQ Configuration
# ------------------------------------------------------------------------------
# Local Docker or Hosted Redis (Upstash)
# Note: The BullMQ worker process requires a durable connection (npm run worker)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# AI Provider Configuration (Google Gemini Verified Models)
# ------------------------------------------------------------------------------
# Google AI Studio API Key (Free tier: 15 RPM, 1M TPM)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Provider: "local" (default offline @xenova/transformers), "gemini" (Google AI Studio), or "mock" (infrastructure tests)
# For local: EMBEDDING_PROVIDER=local, EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2, EMBEDDING_DIMENSIONS=384
# For gemini: EMBEDDING_PROVIDER=gemini, EMBEDDING_MODEL=gemini-embedding-001, EMBEDDING_DIMENSIONS=768
# For mock: EMBEDDING_PROVIDER=mock, EMBEDDING_MODEL=mock-embedding-768, EMBEDDING_DIMENSIONS=768
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# LLM Generation Provider: "deepseek" (official OpenAI-compatible API), "gemini", or "groq"
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: Google Gemini API Key (if LLM_PROVIDER=gemini is selected)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq API Key (if LLM_PROVIDER=groq is selected)
# GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# RAG Retrieval & Safety Thresholds
# ------------------------------------------------------------------------------
# Cosine similarity refusal gate threshold (0.0 to 1.0). Calibrated against benchmark dataset: 0.47
SIMILARITY_THRESHOLD=0.47

# Default Top-K retrieval count (3 or 5)
DEFAULT_TOP_K=5

# Default Chunking Strategy: "structure_aware" or "fixed"
DEFAULT_CHUNKING_STRATEGY=structure_aware

# ------------------------------------------------------------------------------
# Production Concerns, Rate Limits & Budget Controls
# ------------------------------------------------------------------------------
# Deployment Environment: "development" or "production"
NODE_ENV=production

# Read-only demonstration mode: disables POST /api/ingest
READ_ONLY_MODE=true

# Secret admin key required to access /api/jobs, /api/logs, and POST /api/ingest
ADMIN_API_KEY=generate_a_secure_random_key_here

# Redis sliding-window chat rate limit per IP per minute
RATE_LIMIT_PER_MINUTE=10

# DeepSeek Daily Cost & Volume Safeguards (fail-closed in production if exceeded)
DAILY_REQUEST_LIMIT=500
DAILY_BUDGET_USD=2.00

# Logging Level: debug, info, warn, error
LOG_LEVEL=info
